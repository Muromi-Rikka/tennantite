---
import type { PixelIconName } from "@verdigris/textures";
import { pixelIcons } from "@verdigris/textures";
import { Icon } from "@verdigris/ui";

const icons = Object.keys(pixelIcons) as PixelIconName[];
---
<div class="mt-8 grid grid-cols-2 gap-8 sm:grid-cols-3">
  {icons.map(name => (
    <div class="flex items-center gap-4 border border-site-border bg-site-surface p-4">
      <Icon name={name} size={12} />
      <code class="font-mono text-xs text-site-muted">{name}</code>
    </div>
  ))}
</div>
