---
import type { DocsNavGroup } from "@/lib/docs";

interface Props {
  groups: DocsNavGroup[];
  label: string;
  pathname: string;
}
const { groups, label, pathname } = Astro.props;
const isActive = (href: string) => {
  const isIndex = href === "/docs/" || href === "/en/docs/";
  return isIndex ? pathname === href : pathname === href || pathname.startsWith(href);
};
---
<nav aria-label={label}>
  {groups.map(group => (
    <div class="mt-16 first:mt-0">
      <h2 class="text-xs uppercase tracking-wider text-site-muted">{group.title}</h2>
      <ul class="mt-4">
        {group.items.map(item => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "-ml-px block border-l py-2 pl-8 text-sm",
                  active
                    ? "border-mc-gold text-site-fg"
                    : "border-transparent text-site-muted hover:text-site-fg",
                ]}
              >
                {item.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>
