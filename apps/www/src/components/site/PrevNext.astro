---
interface PagerItem {
  href: string;
  title: string;
}
interface Props {
  next?: PagerItem;
  prev?: PagerItem;
}
const { next, prev } = Astro.props;
---
<nav aria-label="翻页" class="mt-32 flex flex-col gap-8 border-t border-site-border pt-16 sm:flex-row sm:justify-between">
  {prev
    ? (
        <a class="group flex flex-col gap-1" href={prev.href}>
          <span class="text-xs text-site-muted">上一页</span>
          <span class="text-sm text-site-fg group-hover:text-site-accent">{prev.title}</span>
        </a>
      )
    : <span aria-hidden="true"></span>}
  {next
    ? (
        <a class="group flex flex-col gap-1 sm:text-right" href={next.href}>
          <span class="text-xs text-site-muted">下一页</span>
          <span class="text-sm text-site-fg group-hover:text-site-accent">{next.title}</span>
        </a>
      )
    : <span aria-hidden="true"></span>}
</nav>
