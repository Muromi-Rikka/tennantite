---
import type { Locale } from "@/i18n";
import { ui } from "@/i18n";

interface PagerItem {
  href: string;
  title: string;
}
interface Props {
  locale: Locale;
  next?: PagerItem;
  prev?: PagerItem;
}
const { locale, next, prev } = Astro.props;
const text = ui[locale].pager;
---
<nav aria-label={text.previous} class="mt-32 flex flex-col gap-8 border-t border-site-border pt-16 sm:flex-row sm:justify-between">
  {prev
    ? (
        <a class="group flex flex-col gap-1" href={prev.href}>
          <span class="text-xs text-site-muted">{text.previous}</span>
          <span class="text-sm text-site-fg group-hover:text-site-accent">{prev.title}</span>
        </a>
      )
    : <span aria-hidden="true"></span>}
  {next
    ? (
        <a class="group flex flex-col gap-1 sm:text-right" href={next.href}>
          <span class="text-xs text-site-muted">{text.next}</span>
          <span class="text-sm text-site-fg group-hover:text-site-accent">{next.title}</span>
        </a>
      )
    : <span aria-hidden="true"></span>}
</nav>
