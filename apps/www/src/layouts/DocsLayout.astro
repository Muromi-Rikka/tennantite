---
import SiteLayout from "./SiteLayout.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import PrevNext from "@/components/site/PrevNext.astro";
import DocsSidebar from "@/components/docs/DocsSidebar.astro";
import DocsToc from "@/components/docs/DocsToc.astro";
import MobileDocsNav from "@/components/docs/MobileDocsNav.astro";
import { getCollection } from "astro:content";
import { ui } from "@/i18n";
import { buildDocsNav, docHref, docSlug, filterDocs, getDocsPager, type DocEntry, type DocHeading } from "@/lib/docs";
import { breadcrumb, techArticle } from "@/lib/seo";

interface Props {
  entry: DocEntry;
  headings: DocHeading[];
}
const { entry, headings } = Astro.props;
const locale = entry.data.locale;
const text = ui[locale];
const docs = filterDocs(await getCollection("docs"), locale);
const nav = buildDocsNav(docs, locale);
const href = docHref(entry.id);
const isIndex = docSlug(entry.id) === "index";
const docsIndexHref = docHref(locale === "en" ? "en/index" : "index");
const pager = getDocsPager(docs, entry.id);
const site = Astro.site ?? new URL("http://localhost:3300");
const jsonLd = [
  techArticle({ description: entry.data.description, locale, path: href, site, title: entry.data.title }),
  ...(isIndex
    ? []
    : [breadcrumb({ items: [{ label: text.docsChrome.breadcrumb, path: docsIndexHref }, { label: entry.data.title, path: href }], site })]),
];
---
<SiteLayout
  title={`${entry.data.title} · ${text.docsChrome.metaSuffix}`}
  description={entry.data.description}
  locale={locale}
  type="article"
  jsonLd={jsonLd}
>
  <div class="mx-auto flex w-full max-w-[1440px] gap-24 px-12">
    <aside class="hidden w-[200px] shrink-0 lg:block">
      <div class="sticky top-32 max-h-[calc(100vh-128px)] overflow-y-auto py-24">
        <DocsSidebar groups={nav} label={text.docsChrome.mobileNav} pathname={Astro.url.pathname} />
      </div>
    </aside>
    <div class="min-w-0 flex-1">
      <MobileDocsNav groups={nav} title={text.docsChrome.mobileNav} />
      <div class="grid gap-24 pt-24 pb-32 xl:grid-cols-[minmax(0,1fr)_160px]">
        <article class="min-w-0">
          <PageHeader
            breadcrumb={isIndex
              ? [{ label: text.docsChrome.breadcrumb }]
              : [{ href: docsIndexHref, label: text.docsChrome.breadcrumb }, { label: entry.data.title }]}
            title={entry.data.title}
            description={entry.data.description}
          />
          <div class="docs-prose mt-16" data-copy-scope><slot /></div>
          <PrevNext locale={locale} prev={pager.prev} next={pager.next} />
        </article>
        <DocsToc headings={headings.filter(heading => heading.depth === 2)} title={text.docsChrome.toc} />
      </div>
    </div>
  </div>
</SiteLayout>
