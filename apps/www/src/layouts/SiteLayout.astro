---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";

interface Props {
  description: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  title: string;
  type?: "article" | "website";
}
---
<BaseLayout {...Astro.props}>
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:border focus:border-site-border focus:bg-site-surface focus:px-8 focus:py-4"
  >
    跳到主要内容
  </a>
  <SiteHeader />
  <main id="main-content" class="flex-1"><slot /></main>
  <SiteFooter />
</BaseLayout>
