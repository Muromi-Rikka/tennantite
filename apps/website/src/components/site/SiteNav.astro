---
import type { Locale } from "@/i18n";
import { localeHref, ui } from "@/i18n";
import { findComponent, isModEntry } from "@/lib/catalog";

interface Props {
  locale: Locale;
  pathname: string;
}
const { locale, pathname } = Astro.props;
const text = ui[locale];
const items = [
  { href: localeHref(locale, "/docs/"), label: text.nav.docs },
  { href: localeHref(locale, "/components/"), label: text.nav.components },
  { href: localeHref(locale, "/blocks/"), label: text.nav.blocks },
  { href: localeHref(locale, "/mods/"), label: text.nav.mods },
];
const slug = pathname.split("/").filter(Boolean).at(-1);
const entry = slug ? findComponent(slug) : undefined;
const activePath = pathname.includes("/mods/") || (entry ? isModEntry(entry) : false)
  ? localeHref(locale, "/mods/")
  : pathname;
const isActive = (href: string) => activePath === href || activePath.startsWith(href);
---
<nav aria-label={locale === "zh" ? "主导航" : "Main navigation"} class="hidden items-center gap-2 md:flex">
  {items.map(item => (
    <a
      href={item.href}
      aria-current={isActive(item.href) ? "page" : undefined}
      class:list={[
        "px-4 py-2 text-sm transition-colors",
        isActive(item.href) ? "text-site-fg" : "text-site-muted hover:text-site-fg",
      ]}
    >
      {item.label}
    </a>
  ))}
</nav>
