---
interface Props {
  class?: string;
  href: string;
  rel?: string;
  target?: string;
  variant?: "default" | "ghost" | "success";
}
const { class: className, href, rel, target, variant = "default" } = Astro.props;
---
<a
  href={href}
  rel={rel}
  target={target}
  class:list={[
    "mc-text-shadow inline-flex h-20 items-center justify-center px-8 font-mc mc-text text-mc-text-main no-underline select-none",
    variant === "default" && "mc-tex-btn",
    variant === "success" && "mc-tex-btn-success",
    variant === "ghost" && "border border-site-border bg-transparent hover:bg-white/5",
    "focus-visible:mc-outline focus-visible:outline-white",
    className,
  ]}
>
  <slot />
</a>
