---
import { Icon } from "@tennantite/ui";
import type { Locale } from "@/i18n";
import { localeHref, ui } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = ui[locale].footer;
---
<footer class="border-t border-site-border">
  <div class="mx-auto grid max-w-[1440px] gap-24 px-12 py-32 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="max-w-[320px]">
      <a href={localeHref(locale, "/")} class="flex items-center gap-4 text-base font-bold tracking-wide hover:text-mc-gold">
        <Icon name="grass-block" size={8} />
        Tennantite
      </a>
      <p class="mt-8 text-sm leading-12 text-site-muted">{text.description}</p>
      <p class="mt-4 text-xs text-site-muted">{text.notice}</p>
    </div>
    {text.columns.map(column => (
      <div>
        <h2 class="text-xs uppercase tracking-wider text-site-fg">{column.title}</h2>
        <ul class="mt-8 flex flex-col gap-2">
          {column.links.map(link => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
                class="text-sm text-site-muted hover:text-site-fg"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-site-border">
    <div class="mx-auto flex max-w-[1440px] flex-col gap-2 px-12 py-8 text-xs text-site-muted sm:flex-row sm:justify-between">
      <span>{text.copyright}</span>
      <span>{text.assets}</span>
    </div>
  </div>
</footer>
