---
import type { Locale } from "@/i18n";
import { ui } from "@/i18n";
import type { CatalogEntry } from "@/lib/catalog";
import ComponentNav from "./ComponentNav.astro";

interface Props {
  currentSlug?: string;
  entries?: CatalogEntry[];
  locale: Locale;
}
const { currentSlug, entries, locale } = Astro.props;
const label = ui[locale].componentsPage.listLabel;
---
<details class="mb-16 border border-site-border bg-site-surface p-8 lg:hidden">
  <summary class="cursor-pointer list-none text-sm text-site-fg marker:hidden [&::-webkit-details-marker]:hidden">
    {label}
  </summary>
  <div class="mt-8">
    <ComponentNav currentSlug={currentSlug} entries={entries} locale={locale} />
  </div>
</details>
