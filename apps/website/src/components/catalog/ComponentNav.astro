---
import type { Locale } from "@/i18n";
import { ui } from "@/i18n";
import {
  componentGroups,
  components,
  componentHref,
  componentTitle,
  groupText,
  type CatalogEntry,
} from "@/lib/catalog";

interface Props {
  currentSlug?: string;
  entries?: CatalogEntry[];
  locale: Locale;
}
const { currentSlug, entries = components, locale } = Astro.props;
const label = ui[locale].componentsPage.listLabel;
const groups = componentGroups
  .map(group => ({
    ...group,
    title: groupText(group, locale).title,
    items: entries.filter(component => component.group === group.id),
  }))
  .filter(group => group.items.length > 0);
---
<nav aria-label={label}>
  {groups.map(group => (
    <div class="mt-16 first:mt-0">
      <h2 class="flex items-baseline justify-between gap-4 text-xs uppercase tracking-wider text-site-muted">
        <span>{group.title}</span>
        <span>{group.level}</span>
      </h2>
      <ul class="mt-4">
        {group.items.map((item) => {
          const active = item.slug === currentSlug;
          return (
            <li>
              <a
                href={componentHref(item.slug, locale)}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "-ml-px block border-l py-2 pl-8 text-sm break-words",
                  active ? "border-mc-gold text-site-fg" : "border-transparent text-site-muted hover:text-site-fg",
                ]}
              >
                {componentTitle(item, locale)}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>
