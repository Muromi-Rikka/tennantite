---
import PageHeader from "@/components/site/PageHeader.astro";
import LinkButton from "@/components/site/LinkButton.astro";
import DocsSidebar from "@/components/docs/DocsSidebar.astro";
import MobileDocsNav from "@/components/docs/MobileDocsNav.astro";
import type { Locale } from "@/i18n";
import { fill, localeHref, ui } from "@/i18n";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { buildSiteNav } from "@/lib/nav";
import {
  catalogDescription,
  componentGroups,
  componentHref,
  componentTitle,
  coreComponents,
  groupText,
  modEntries,
} from "@/lib/catalog";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = ui[locale].componentsPage;
const description = fill(text.description, { count: coreComponents.length });
const modsText = ui[locale].modsPage;
const modsHref = localeHref(locale, "/mods/");
const groups = componentGroups
  .map(group => ({
    ...group,
    items: coreComponents.filter(component => component.group === group.id),
  }))
  .filter(group => group.items.length > 0);
const nav = await buildSiteNav(locale);
---
<SiteLayout title={text.metaTitle} description={description} locale={locale}>
  <div class="mx-auto flex w-full max-w-[1440px] gap-24 px-12">
    <aside class="hidden w-[200px] shrink-0 lg:block">
      <div class="sticky top-32 max-h-[calc(100vh-128px)] overflow-y-auto py-24">
        <DocsSidebar groups={nav} label={ui[locale].docsChrome.mobileNav} pathname={Astro.url.pathname} />
      </div>
    </aside>
    <div class="min-w-0 flex-1 py-24">
      <MobileDocsNav groups={nav} title={ui[locale].docsChrome.mobileNav} />
    <PageHeader
      breadcrumb={[{ label: text.breadcrumb }]}
      title={text.title}
      description={description}
    />
    <div class="mt-16 flex flex-wrap items-center justify-between gap-8 border border-site-border bg-site-surface px-12 py-8">
      <div>
        <h2 class="text-base font-bold text-site-fg">{modsText.title}</h2>
        <p class="mt-2 text-sm text-site-muted">{modsText.description}</p>
      </div>
      <LinkButton href={modsHref} variant="ghost">{modsText.breadcrumb} · {modEntries.length} →</LinkButton>
    </div>
    {groups.map((group) => {
      const groupLabel = groupText(group, locale);
      return (
        <section id={group.id} class="mt-32 scroll-mt-32">
          <div class="flex items-baseline gap-8 border-b border-site-border pb-8">
            <h2 class="text-2xl font-bold text-site-fg">{groupLabel.title}</h2>
            <span class="text-xs uppercase tracking-wider text-site-muted">{group.level}</span>
            <span class="ml-auto text-sm text-site-muted">{group.items.length}</span>
          </div>
          <p class="mt-8 text-sm leading-12 text-site-muted">{groupLabel.description}</p>
          <div class="grid gap-x-24 md:grid-cols-2">
            {group.items.map(component => (
              <a
                href={componentHref(component.slug, locale)}
                class="group flex flex-col gap-2 border-b border-site-border/60 py-8"
              >
                <span class="text-base text-site-fg group-hover:text-site-accent">{componentTitle(component, locale)}</span>
                <span class="text-sm leading-12 text-site-muted">{catalogDescription(component, locale)}</span>
              </a>
            ))}
          </div>
        </section>
      );
    })}
    </div>
  </div>
</SiteLayout>

