---
import PageHeader from "@/components/site/PageHeader.astro";
import ScaledPreview from "@/components/preview/ScaledPreview.astro";
import type { Locale } from "@/i18n";
import { localeHref, ui } from "@/i18n";
import SiteLayout from "@/layouts/SiteLayout.astro";
import {
  catalogDescription,
  componentHref,
  componentTitle,
  commonComponents,
  modCatalog,
  modIds,
} from "@/lib/catalog";
import type { ModTarget } from "@/lib/catalog";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = ui[locale].modsPage;

/** 各 mod 卡片的代表预览（catalog entry.name，对应 Demo registry）。 */
const representative: Record<ModTarget, string> = {
  ae2: "Ae2TerminalScreen",
  create: "CreateMillstoneScreen",
  enderio: "EioAlloySmelterScreen",
  farmersdelight: "FdCookingPotScreen",
  ic2: "MaceratorScreen",
  ie: "IeCokeOvenScreen",
  industrialforegoing: "IfDissolutionChamberScreen",
  mekanism: "MekanismMachineScreen",
  thermal: "ThermalRedstoneFurnaceScreen",
};
---
<SiteLayout title={text.metaTitle} description={text.description} locale={locale}>
  <div class="mx-auto max-w-[1440px] px-12 py-24">
    <PageHeader
      breadcrumb={[{ label: text.breadcrumb }]}
      title={text.title}
      description={text.description}
    />

    <div class="mt-32 grid gap-16 lg:grid-cols-3">
      {modIds.map((id) => {
        const entry = modCatalog[id];
        const href = localeHref(locale, `/mods/${id}/`);
        return (
          <a
            href={href}
            class="group block border border-site-border bg-site-surface transition-colors hover:border-site-fg/40"
          >
            <ScaledPreview
              class="h-[360px] bg-[#0d0d0d] sm:h-[400px]"
              name={representative[id]}
            />
            <div class="flex flex-col gap-2 border-t border-site-border px-8 py-6">
              <div class="flex items-center justify-between">
                <span class="text-sm text-site-fg group-hover:text-site-accent">{text.mods[id].title}</span>
                <span aria-hidden="true" class="text-site-muted">→</span>
              </div>
              <span class="text-xs text-site-muted">
                {entry.blocks.length} {text.screens.title} · {entry.components.length} {text.components.title}
              </span>
            </div>
          </a>
        );
      })}
    </div>

    {commonComponents.length > 0 && (
      <section class="mt-32">
        <div class="flex items-baseline gap-8 border-b border-site-border pb-8">
          <h2 class="text-2xl font-bold text-site-fg">{text.common.title}</h2>
          <span class="ml-auto text-sm text-site-muted">{commonComponents.length}</span>
        </div>
        <p class="mt-8 text-sm leading-12 text-site-muted">{text.common.description}</p>
        <div class="grid gap-x-24 md:grid-cols-2">
          {commonComponents.map(component => (
            <a
              href={componentHref(component.slug, locale)}
              class="group flex flex-col gap-2 border-b border-site-border/60 py-8"
            >
              <div class="flex flex-wrap items-baseline gap-4">
                <span class="text-base text-site-fg group-hover:text-site-accent">{componentTitle(component, locale)}</span>
                <span class="font-mono text-xs text-site-muted">{component.name}</span>
              </div>
              <span class="text-sm leading-12 text-site-muted">{catalogDescription(component, locale)}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</SiteLayout>
