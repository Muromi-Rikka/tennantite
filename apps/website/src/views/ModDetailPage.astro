---
import PageHeader from "@/components/site/PageHeader.astro";
import ScaledPreview from "@/components/preview/ScaledPreview.astro";
import type { Locale } from "@/i18n";
import { localeHref, ui } from "@/i18n";
import SiteLayout from "@/layouts/SiteLayout.astro";
import {
  blockHref,
  catalogDescription,
  componentHref,
  componentTitle,
  modCatalog,
} from "@/lib/catalog";
import type { ModTarget } from "@/lib/catalog";

interface Props {
  locale: Locale;
  mod: ModTarget;
}
const { locale, mod } = Astro.props;
const text = ui[locale].modsPage;
const modText = text.mods[mod];
const { blocks: screens, components: componentEntries, frames, parts } = modCatalog[mod];
const overviewHref = localeHref(locale, "/mods/");
---
<SiteLayout title={`${modText.title} · Tennantite`} description={modText.description} locale={locale}>
  <div class="mx-auto max-w-[1440px] px-12 py-24">
    <PageHeader
      breadcrumb={[{ href: overviewHref, label: text.breadcrumb }, { label: modText.title }]}
      title={modText.title}
      description={modText.description}
    />

    <div class="mod-view mt-32">
      <input checked class="sr-only" id="mod-view-components" name="mod-view" type="radio" />
      <input class="sr-only" id="mod-view-screens" name="mod-view" type="radio" />

      <div class="mod-view-switch flex flex-wrap gap-4 border-b border-site-border pb-8">
        <label class="flex items-center gap-4 border border-transparent px-8 py-4 text-sm text-site-muted transition-colors hover:text-site-fg" for="mod-view-components">
          {text.components.title}<span class="font-mono text-xs">{componentEntries.length}</span>
        </label>
        <label class="flex items-center gap-4 border border-transparent px-8 py-4 text-sm text-site-muted transition-colors hover:text-site-fg" for="mod-view-screens">
          {text.screens.title}<span class="font-mono text-xs">{screens.length}</span>
        </label>
      </div>

      <section class="mod-view-panel mod-view-panel-components">
        <div class="mt-24 flex items-baseline gap-8 border-b border-site-border pb-8">
          <h2 class="text-2xl font-bold text-site-fg">{text.components.title}</h2>
          <span class="ml-auto text-sm text-site-muted">{componentEntries.length}</span>
        </div>
        <p class="mt-8 text-sm leading-12 text-site-muted">{text.components.description}</p>

        {[
          { entries: parts, text: text.parts, cropHeight: false },
          { entries: frames, text: text.frames, cropHeight: true },
        ].filter(group => group.entries.length > 0).map(group => (
          <div class="mt-24">
            <div class="flex items-baseline gap-8 border-b border-site-border/60 pb-6">
              <h3 class="text-base font-bold text-site-fg">{group.text.title}</h3>
              <span class="ml-auto text-sm text-site-muted">{group.entries.length}</span>
            </div>
            <p class="mt-6 text-sm leading-12 text-site-muted">{group.text.description}</p>
            <div class="mt-12 grid gap-16 sm:grid-cols-2 xl:grid-cols-3">
              {group.entries.map(component => (
                <a
                  class="group flex flex-col border border-site-border bg-site-surface transition-colors hover:border-site-fg/40"
                  href={componentHref(component.slug, locale)}
                >
                  <ScaledPreview class="h-[200px] bg-[#0d0d0d]" cropHeight={group.cropHeight} name={component.name} />
                  <div class="flex flex-col gap-2 border-t border-site-border px-8 py-6">
                    <div class="flex flex-wrap items-baseline gap-4">
                      <span class="text-sm text-site-fg group-hover:text-site-accent">{componentTitle(component, locale)}</span>
                      <span class="font-mono text-xs text-site-muted">{component.name}</span>
                    </div>
                    <span class="text-xs leading-11 text-site-muted">{catalogDescription(component, locale)}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>

      <section class="mod-view-panel mod-view-panel-screens">
        <div class="mt-24 flex items-baseline gap-8 border-b border-site-border pb-8">
          <h2 class="text-2xl font-bold text-site-fg">{text.screens.title}</h2>
          <span class="ml-auto text-sm text-site-muted">{screens.length}</span>
        </div>
        <p class="mt-8 text-sm leading-12 text-site-muted">{text.screens.description}</p>
        <div class="mt-16 grid gap-16 lg:grid-cols-2">
          {screens.map(screen => (
            <a
              class="group block border border-site-border bg-site-surface transition-colors hover:border-site-fg/40"
              href={blockHref(screen.slug, locale)}
            >
              <ScaledPreview class="h-[360px] bg-[#0d0d0d] sm:h-[400px]" name={screen.name} />
              <div class="flex items-center justify-between border-t border-site-border px-8 py-6">
                <div class="flex flex-col gap-1">
                  <span class="text-sm text-site-fg group-hover:text-site-accent">{componentTitle(screen, locale)}</span>
                  <span class="font-mono text-xs text-site-muted">{screen.name}</span>
                </div>
                <span aria-hidden="true" class="text-site-muted">→</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</SiteLayout>

<style>
  .mod-view-panel {
    display: none;
  }
  #mod-view-components:checked ~ .mod-view-panel-components,
  #mod-view-screens:checked ~ .mod-view-panel-screens {
    display: block;
  }
  #mod-view-components:checked ~ .mod-view-switch label[for="mod-view-components"],
  #mod-view-screens:checked ~ .mod-view-switch label[for="mod-view-screens"] {
    border-color: var(--color-site-border);
    background-color: var(--color-site-elevated);
    color: var(--color-site-fg);
  }
  #mod-view-components:focus-visible ~ .mod-view-switch label[for="mod-view-components"],
  #mod-view-screens:focus-visible ~ .mod-view-switch label[for="mod-view-screens"] {
    outline: 1px solid var(--color-site-accent);
    outline-offset: 2px;
  }
</style>
