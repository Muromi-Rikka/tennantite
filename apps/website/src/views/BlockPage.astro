---
import { Code } from "astro:components";
import { ScaledBox } from "@tennantite/ui";
import Demo from "@/components/preview/demo";
import LinkButton from "@/components/site/LinkButton.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import DocsSidebar from "@/components/docs/DocsSidebar.astro";
import MobileDocsNav from "@/components/docs/MobileDocsNav.astro";
import PrevNext from "@/components/site/PrevNext.astro";
import type { Locale } from "@/i18n";
import { fill, localeHref, ui } from "@/i18n";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { buildSiteNav } from "@/lib/nav";
import { blockComposition } from "@/lib/blocks";
import {
  blockHref,
  catalogDescription,
  componentHref,
  componentTitle,
  findComponentByName,
  getBlockPager,
  isModEntry,
  modCatalog,
  modIndexHref,
  previewHref,
  primaryBlocks,
  type CatalogEntry,
  type ModTarget,
} from "@/lib/catalog";
import { breadcrumb, techArticle } from "@/lib/seo";
import { readDemoSource } from "@/lib/source";

interface Props {
  entry: CatalogEntry;
  locale: Locale;
}
const { entry, locale } = Astro.props;
const text = ui[locale].blockPage;
const modsText = ui[locale].modsPage;
const description = catalogDescription(entry, locale);
const displayName = componentTitle(entry, locale);
const mod = isModEntry(entry);
const modScope: ModTarget | undefined = entry.mod !== undefined && entry.mod !== "common" ? entry.mod : undefined;
const href = blockHref(entry.slug, locale);
const indexHref = modScope ? modIndexHref(entry, locale) : localeHref(locale, "/blocks/");
const indexLabel = mod ? modsText.breadcrumb : text.breadcrumb;
const preview = previewHref(entry.slug, locale);
const code = readDemoSource(entry.sourceDir);
const pager = getBlockPager(entry.slug, locale, modScope ? modCatalog[modScope].blocks : primaryBlocks);
const composition = (blockComposition[entry.slug] ?? [])
  .map(name => findComponentByName(name))
  .filter((component): component is CatalogEntry => component !== undefined);
const site = Astro.site ?? new URL("http://localhost:3300");
const nav = await buildSiteNav(locale);
const jsonLd = [
  techArticle({ description, locale, path: href, site, title: displayName }),
  breadcrumb({ items: [{ label: indexLabel, path: indexHref }, { label: displayName, path: href }], site }),
];
---
<SiteLayout
  title={`${displayName} ${text.metaTitleSuffix}`}
  description={`${description} ${fill(text.metaDescriptionSuffix, { name: displayName })}`}
  locale={locale}
  type="article"
  jsonLd={jsonLd}
>
  <div class="mx-auto flex w-full max-w-[1440px] gap-24 px-12">
    <aside class="hidden w-[200px] shrink-0 lg:block">
      <div class="sticky top-32 max-h-[calc(100vh-128px)] overflow-y-auto py-24">
        <DocsSidebar groups={nav} label={ui[locale].docsChrome.mobileNav} pathname={Astro.url.pathname} />
      </div>
    </aside>
    <div class="min-w-0 flex-1 py-24">
      <MobileDocsNav groups={nav} title={ui[locale].docsChrome.mobileNav} />
      <PageHeader
      breadcrumb={[{ href: indexHref, label: indexLabel }, { label: displayName }]}
      title={displayName}
      description={description}
    />

    <div class="mt-12 flex flex-wrap items-center gap-8">
      <LinkButton href={preview} target="_blank" rel="noreferrer">{text.fullPreview}</LinkButton>
      <span class="text-xs text-site-muted">{text.unindexed}</span>
    </div>

    <div class="mc-scroll mt-16 overflow-x-auto border border-site-border bg-[#1f1f1f] p-16 sm:p-24">
      <ScaledBox client:load>
        <Demo client:load name={entry.name} />
      </ScaledBox>
    </div>

    <section class="mt-32">
      <h2 class="text-2xl font-bold text-site-fg">{text.composition}</h2>
      <p class="mt-4 text-sm leading-12 text-site-muted">{text.compositionNote}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        {composition.map(component => (
          <a
            class="border border-site-border bg-site-surface px-4 py-2 font-mono text-xs text-site-fg hover:text-site-accent"
            href={componentHref(component.slug, locale)}
          >
            {componentTitle(component, locale)}
          </a>
        ))}
      </div>
    </section>

    <section class="mt-32">
      <h2 class="text-2xl font-bold text-site-fg">{text.code}</h2>
      <div class="mt-8 overflow-x-auto border border-site-border bg-[#080808] p-8" data-copy-scope>
        <Code code={code} lang="tsx" />
      </div>
    </section>

    <PrevNext locale={locale} prev={pager.prev} next={pager.next} />
    </div>
  </div>
</SiteLayout>
