---
import { Code } from "astro:components";
import InstallCommand from "@/components/docs/InstallCommand.astro";
import DocsSidebar from "@/components/docs/DocsSidebar.astro";
import MobileDocsNav from "@/components/docs/MobileDocsNav.astro";
import PropsTable from "@/components/docs/PropsTable.astro";
import PreviewTabs from "@/components/preview/preview-tabs";
import PageHeader from "@/components/site/PageHeader.astro";
import PageSection from "@/components/site/PageSection.astro";
import PrevNext from "@/components/site/PrevNext.astro";
import type { Locale } from "@/i18n";
import { fill, localeHref, ui } from "@/i18n";
import SiteLayout from "@/layouts/SiteLayout.astro";
import {
  catalogDescription,
  componentHref,
  componentTitle,
  coreComponents,
  getComponentPager,
  isModEntry,
  modIndexHref,
  modScopeEntries,
  type CatalogEntry,
} from "@/lib/catalog";
import { buildSiteNav } from "@/lib/nav";
import { componentProps } from "@/lib/props";
import { readDemoSource } from "@/lib/source";
import { breadcrumb, techArticle } from "@/lib/seo";

interface Props {
  entry: CatalogEntry;
  locale: Locale;
}
const { entry, locale } = Astro.props;
const text = ui[locale];
const page = text.componentPage;
const description = catalogDescription(entry, locale);
const displayName = componentTitle(entry, locale);
const mod = isModEntry(entry);
const entries = mod ? modScopeEntries(entry) : coreComponents;
const href = componentHref(entry.slug, locale);
const indexHref = mod ? modIndexHref(entry, locale) : localeHref(locale, "/components/");
const indexLabel = mod ? text.modsPage.breadcrumb : page.breadcrumb;
const code = readDemoSource(entry.sourceDir);
const pager = getComponentPager(entry.slug, locale, entries);
const nav = await buildSiteNav(locale);
const isCore = !mod && ["primitives", "containers"].includes(entry.group);
const props = isCore ? componentProps[entry.slug] : undefined;
const site = Astro.site ?? new URL("http://localhost:3300");
const jsonLd = [
  techArticle({ description, locale, path: href, site, title: displayName }),
  breadcrumb({ items: [{ label: indexLabel, path: indexHref }, { label: displayName, path: href }], site }),
];
---
<SiteLayout
  title={`${displayName} ${page.metaTitleSuffix}`}
  description={`${description} ${fill(page.metaDescriptionSuffix, { name: displayName })}`}
  locale={locale}
  type="article"
  jsonLd={jsonLd}
>
  <div class="mx-auto flex w-full max-w-[1440px] gap-24 px-12">
    <aside class="hidden w-[200px] shrink-0 lg:block">
      <div class="sticky top-32 max-h-[calc(100vh-128px)] overflow-y-auto py-24">
        <DocsSidebar groups={nav} label={text.docsChrome.mobileNav} pathname={Astro.url.pathname} />
      </div>
    </aside>

    <div class="min-w-0 flex-1 py-24">
      <MobileDocsNav groups={nav} title={text.docsChrome.mobileNav} />
      <PageHeader
        breadcrumb={[{ href: indexHref, label: indexLabel }, { label: displayName }]}
        title={displayName}
        description={description}
      />
      <PreviewTabs client:load code={code} locale={locale} name={entry.name} />

      <PageSection title={page.install}>
        {mod ? (
          <InstallCommand command={`pnpm add @tennantite/${entry.mod}`} locale={locale} />
        ) : (
          <>
            <h3 class="text-sm font-bold text-site-fg">{page.installCli}</h3>
            <InstallCommand command={`npx shadcn add @tennantite/${entry.slug}`} locale={locale} />
            <h3 class="mt-12 text-sm font-bold text-site-fg">{page.installNpm}</h3>
            <InstallCommand command="pnpm add @tennantite/ui" locale={locale} />
          </>
        )}
        <p class="mt-4 text-xs text-site-muted">{page.installNote}</p>
      </PageSection>

      {isCore && (
        <PageSection title={page.usage}>
          <h3 class="text-sm font-bold text-site-fg">{page.usageNpm}</h3>
          <Code lang="tsx" code={`import { ${entry.exports.join(", ")} } from "@tennantite/ui";`} />
          <h3 class="mt-12 text-sm font-bold text-site-fg">{page.usageCli}</h3>
          <Code
            lang="tsx"
            code={`import { ${entry.exports.join(", ")} } from "@/components/tennantite/${entry.slug}";`}
          />
          <div class="mt-12">
            <Code lang="tsx" code={code} />
          </div>
        </PageSection>
      )}

      {isCore && props && (
        <PageSection title={page.api}>
          <PropsTable locale={locale} props={props} />
        </PageSection>
      )}

      <PageSection title={page.source}>
        <code class="font-mono text-sm text-site-fg">{entry.sourceDir}/index.tsx</code>
        <p class="mt-4 text-sm leading-12 text-site-muted">{page.sourceNote}</p>
      </PageSection>

      <PrevNext locale={locale} prev={pager.prev} next={pager.next} />
    </div>
  </div>
</SiteLayout>
