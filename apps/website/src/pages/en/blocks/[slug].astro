---
import { blocks, type CatalogEntry } from "@/lib/catalog";
import BlockPage from "@/views/BlockPage.astro";

interface Props {
  entry: CatalogEntry;
}

export async function getStaticPaths() {
  return blocks.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<BlockPage entry={entry} locale="en" />
