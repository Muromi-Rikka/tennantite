---
import ModDetailPage from "@/views/ModDetailPage.astro";
import type { ModTarget } from "@/lib/catalog";

export async function getStaticPaths() {
  return ["mekanism", "ic2", "ae2"].map(mod => ({ params: { mod }, props: { mod } }));
}

const { mod } = Astro.props as { mod: ModTarget };
---
<ModDetailPage locale="en" mod={mod} />
