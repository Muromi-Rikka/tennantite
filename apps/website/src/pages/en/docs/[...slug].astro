---
import { getCollection, render } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import type { DocEntry } from "@/lib/docs";
import { docSlug, filterDocs } from "@/lib/docs";

interface Props {
  entry: DocEntry;
}

export async function getStaticPaths() {
  const docs = filterDocs(await getCollection("docs"), "en");
  return docs.filter(entry => docSlug(entry.id) !== "index").map(entry => ({
    params: { slug: docSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<DocsLayout entry={entry} headings={headings}><Content /></DocsLayout>
