{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["SITE_URL"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "next-app#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"]
    },
    "tanstack-app#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".tanstack/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
