{
  "name": "@tennantite/ui",
  "type": "module",
  "version": "0.1.3",
  "description": "Tennantite — Minecraft-style UI components built on shadcn philosophy (Base UI + Tailwind v4)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muromi-Rikka/tennantite.git",
    "directory": "packages/ui"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./demos": {
      "types": "./dist/demos.d.ts",
      "default": "./dist/demos.js"
    },
    "./css/*": "./src/css/*"
  },
  "files": [
    "dist",
    "src/css"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tennantite/textures": "workspace:*",
    "@tennantite/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslib/core": "^1.0.4",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "axe-core": "^4.11.0",
    "jsdom": "^30.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
