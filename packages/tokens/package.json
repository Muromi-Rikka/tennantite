{
  "name": "@tennantite/tokens",
  "type": "module",
  "version": "0.1.2",
  "description": "Tennantite design tokens — Minecraft-style Tailwind v4 theme variables",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muromi-Rikka/tennantite.git",
    "directory": "packages/tokens"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css/*": "./css/*",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "css",
    "fonts",
    "src"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
