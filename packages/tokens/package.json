{
  "name": "@verdigris/tokens",
  "type": "module",
  "version": "0.1.0",
  "description": "Verdigris design tokens — Minecraft-style Tailwind v4 theme variables",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css/*": "./css/*",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "css",
    "fonts",
    "src"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
